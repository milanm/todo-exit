<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TodoExit.Core\TodoExit.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>todo-exit</AssemblyName>
    <RootNamespace>TodoExit.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>todo-exit</ToolCommandName>
    <PackageId>todo-exit</PackageId>
    <Version>0.1.0</Version>
    <Authors>Milan Milanović</Authors>
    <Description>Export Microsoft To Do lists and tasks to JSON, Markdown, Todoist CSV and generic CSV.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/milanm/todo-exit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/milanm/todo-exit</RepositoryUrl>
  </PropertyGroup>

</Project>
